# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI (Whisper API)
OPENAI_API_KEY=your_openai_api_key

# Google (Gemini API)
GOOGLE_AI_API_KEY=your_gemini_api_key
GOOGLE_AI_MODEL=gemini-2.0-flash

# Obsidian日誌への還流 (Discord Webhook → listener_bot.py → 日誌)
# 2nd-Brain/00_システム/devtools/discord_notifier/.env と同じ値
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# 4MB超の音声アップロード用 (Vercel Blob。`vercel blob create-store`で自動設定)
BLOB_READ_WRITE_TOKEN=your_blob_token

# stand.fm local browser automation
# Chrome is used by default. If Chrome is not installed, set your browser path.
STANDFM_BROWSER_CHANNEL=chrome
# STANDFM_CHROME_APP_PATH=/Applications/Google Chrome.app
# STANDFM_BROWSER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# STANDFM_REMOTE_DEBUGGING_PORT=9222
# STANDFM_LOGIN_URL=https://stand.fm/
# STANDFM_DRAFT_URL=https://stand.fm/episodes/new
# STANDFM_MANUAL_URL=https://stand.fm/

# Stripe (Phase 5)
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
